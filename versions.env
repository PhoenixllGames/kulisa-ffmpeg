# Pinned inputs of the Kulisa FFmpeg build. Plain KEY=VALUE, sourced by the shell scripts.
# Every source is verified by SHA-256 after download; the FFmpeg tarball is also verified by its
# GPG signature (key fingerprint pinned below). Changing a value here changes the build output:
# bump BUILD_NUMBER and never rebuild over a published tag.

# Release tag is v<FFMPEG_VERSION>-<BUILD_NUMBER>.
BUILD_NUMBER=1

# Fixed timestamp used for every file in the zip and the source archive (the FFmpeg 9.0.2 release
# signature time, 2026-09-18 02:46:02 UTC), so the archives do not depend on the build date.
SOURCE_DATE_EPOCH=1789699562

# Base image of the Docker build, pinned by digest (ubuntu:24.04 on 2026-10-29).
UBUNTU_IMAGE=ubuntu@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852

# FFmpeg release from ffmpeg.org.
FFMPEG_VERSION=9.0.2
FFMPEG_FILE=ffmpeg-9.0.2.tar.xz
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
FFMPEG_SIG_FILE=ffmpeg-9.0.2.tar.xz.asc
FFMPEG_SIG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz.asc
FFMPEG_SIG_SHA256=d617fd94ea354dadd2a8bb16243d37c44e1e9729b06b6ad58fe30bfb0fa943f2
FFMPEG_KEY_FILE=ffmpeg-devel.asc
FFMPEG_KEY_URL=https://ffmpeg.org/ffmpeg-devel.asc
FFMPEG_KEY_SHA256=397b3becedcd5a98769967ff1ff8501ddc89f8368b8f766e4701377d7dbaabe5
# "FFmpeg release signing key <ffmpeg-devel@ffmpeg.org>", fingerprint published on ffmpeg.org/download.html.
FFMPEG_KEY_FPR=FCF986EA15E6E293A5644F10B4322F04D67658D8

# NVIDIA codec headers (MIT, headers only). FFmpeg 9.0.2 accepts ffnvcodec >= 12.1.14.0.
# NVENC API level of the headers decides the minimum driver; see README.
NV_CODEC_HEADERS_VERSION=13.1.15.0
NV_CODEC_HEADERS_FILE=nv-codec-headers-13.1.15.0.tar.gz
NV_CODEC_HEADERS_URL=https://github.com/FFmpeg/nv-codec-headers/releases/download/n13.1.15.0/nv-codec-headers-13.1.15.0.tar.gz
NV_CODEC_HEADERS_SHA256=52532ceade3d5c1af62624986f13cf01b63c910576b08c0c278756c5e4b41ad0

# AMD Advanced Media Framework headers (MIT, headers only). FFmpeg 9.0.2 needs AMF >= 1.5.2.
AMF_VERSION=1.5.3
AMF_FILE=AMF-headers-v1.5.3.tar.gz
AMF_URL=https://github.com/GPUOpen-LibrariesAndSDKs/AMF/releases/download/v1.5.3/AMF-headers-v1.5.3.tar.gz
AMF_SHA256=0f521ad98041f8001147cded4a660127f18b1c27a801a5cd691bda1fa48381be

# Intel Video Processing Library dispatcher (MIT, static). FFmpeg 9.0.2 needs libvpl >= 2.6.
LIBVPL_VERSION=2.17.0
LIBVPL_FILE=libvpl-2.17.0.tar.gz
LIBVPL_URL=https://github.com/intel/libvpl/archive/refs/tags/v2.17.0.tar.gz
LIBVPL_SHA256=4de3e2faf1e8307fb282e4a43f443191810f6a6b0a484fffa7995ba1c814c6ec
