# Allow list of the Kulisa FFmpeg build. Sourced by scripts/build-ffmpeg.sh.
# Everything else is disabled (--disable-autodetect --disable-everything). Adding a component is a
# one-line change here, followed by a new BUILD_NUMBER in versions.env.
#
# Each value is a space separated list. Names that this FFmpeg version does not know are skipped
# with a warning and listed in the build log and in BUILDINFO.txt.

# Programs (ffplay and ffprobe are not built).
PROGRAMS="ffmpeg"

# Libraries kept (every other library is disabled).
LIBRARIES="avutil avcodec avformat avfilter swscale swresample avdevice"

# Container formats and I/O. FFmpeg gets no network and no file access: pipes only. Input and output
# must be named pipe:0 and pipe:1. The ffmpeg tool maps the input name "-" to the fd protocol, which
# is not built, so "-i -" fails with "Protocol not found"; an output "-" maps to pipe:. The encoder
# probe "-f null -" opens no protocol at all (the null muxer writes nothing).
PROTOCOLS="pipe"
DEMUXERS="flv live_flv"
MUXERS="flv null"
INDEVS="lavfi"

# Codecs. Stage 7 targets accept H.264 and AAC only, so there are no HEVC or AV1 encoders.
# The wrapped_avframe decoder is needed by the lavfi input (one-frame encoder probe).
DECODERS="h264 aac h264_qsv h264_cuvid wrapped_avframe"
ENCODERS="h264_mf h264_nvenc h264_amf h264_qsv aac wrapped_avframe"
# D3D11VA covers Windows 10 and 11; there is no DXVA2 (D3D9) decode path.
HWACCELS="h264_d3d11va h264_d3d11va2 h264_nvdec"
PARSERS="h264 aac"
BSFS="aac_adtstoasc h264_mp4toannexb extract_extradata null"

# Filters. Sources: color, testsrc2, nullsrc, anullsrc, sine.
FILTERS="scale fps format null anull aresample aformat setpts asetpts trim atrim copy hwupload hwdownload hwmap hwupload_cuda scale_cuda scale_qsv vpp_qsv vpp_amf scale_d3d11 color testsrc2 nullsrc anullsrc sine"

# External libraries and platform APIs (--enable-<name>). The NVIDIA, AMD and Intel runtimes are
# loaded from the GPU driver at run time; only the Intel dispatcher (libvpl) is linked in, static.
EXTERNAL="ffnvcodec nvenc nvdec cuvid cuda-llvm amf libvpl mediafoundation d3d11va w32threads"

# Parts that configure enables by default and that no pipeline here needs (--disable-<name>).
# faan: the floating point AAN DCT. Its faandct option is the only thing that selects fdctdsp in this
# build, which compiles the IJG forward DCT (jfdctfst.c, jfdctint.c).
# error-resilience: the h264 decoder only suggests error_resilience (h264_decoder_suggest), which
# selects me_cmp, which selects idctdsp, which compiles the IJG inverse DCT (jrevdct.c). Nothing else
# here selects me_cmp or idctdsp, so this drops the last IJG code. The cost is no h264 error
# concealment on corrupt input; the local OBS to pipe input has no packet loss.
DISABLE="faan error-resilience"
